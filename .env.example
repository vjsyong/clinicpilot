# Copy to .env and fill in real values. Never commit .env.
#
# Development defaults are safe for local work. Production fails closed if the
# prefix, password hash, internal key, or provider credential is missing,
# default, or placeholder-like.

APP_ENV=development

# Browser-facing prefix. Development must use /demo/. Production uses
# /<generated-secret>/ (lowercase letters, digits, hyphens; 8-64 chars).
DEMO_PATH_PREFIX=/demo/

# Argon2id hash of the shared demo password. Generate with:
#   (cd backend && uv run python -m app.auth.password)
# In development an empty value enables the documented dev password
# "clinicpilot-demo". Production requires a real hash.
DEMO_PASSWORD_HASH=

# Server-to-server credential used by the agent's booking REST tools.
# Production requires at least 32 random characters.
INTERNAL_TOOL_KEY=dev-internal-tool-key-change-me

# Internal base URL the application uses to call its own booking REST API.
# Keep this on the private container/host network; it must not traverse
# Cloudflare. Include the runtime prefix and a trailing slash.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000/demo/

# Primary local model (OpenAI-compatible vLLM endpoint; no API key).
# Use the address the app container can reach: LAN, Tailscale, or
# host.docker.internal when the model runs on the same Docker host.
DEFAULT_MODEL=local
LOCAL_MODEL_BASE_URL=http://192.168.1.148:8040/v1
LOCAL_MODEL_ID=gemma-4-26b-a4b-awq
LOCAL_MODEL_TIMEOUT_SECONDS=120
LOCAL_MODEL_TEMPERATURE=0.2
LOCAL_MODEL_TOP_P=0.95
LOCAL_MODEL_TOP_K=64
LOCAL_MODEL_MAX_TOKENS=2048

# Optional DeepSeek backup. The API key is NOT read from this file: enter it
# in the workbench's Model settings dialog. It is kept in process memory only
# and must be re-entered after a restart. These endpoint settings are used when
# a key is configured. Live evaluation may still set DEEPSEEK_API_KEY inline.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=45

# Database. SQLite is intentional for this MVP.
DATABASE_URL=sqlite:///./data/clinicpilot.db

# Retrieval: FastEmbed/ONNX models run on CPU. The Qwen3 query instruction
# prefix is set in app settings; override it with EMBEDDING_QUERY_PREFIX only
# if you also rebuild the index cache.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REVISION=af95f2c416ffe9379369ad64f9113e865db6112c
EMBEDDING_THREADS=8
RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
RERANKER_REVISION=b8c14f4e723d9e0aab4732a7b7b93741eeeb77c2
RERANKER_THREADS=8
RERANKER_ENABLED=true

# Cloudflare tunnel token (production only; never commit).
CLOUDFLARE_TUNNEL_TOKEN=

# Agent execution bounds.
MAX_TOOL_ROUNDS=6
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_MESSAGES=40
SESSION_TTL_HOURS=8

# Optional: rates used only to label Explorer cost estimates. Leave at 0 to
# show token usage without a dollar estimate. Prices are USD per 1M tokens.
MODEL_INPUT_PRICE_PER_MILLION_USD=0.28
MODEL_OUTPUT_PRICE_PER_MILLION_USD=0.42
MODEL_CACHED_INPUT_PRICE_PER_MILLION_USD=0.028
MODEL_PRICING_VERSION=deepseek-public-2025-09
